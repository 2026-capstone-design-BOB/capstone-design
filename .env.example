# Pluiz 환경변수 템플릿
# ─────────────────────────────────────────────────────────────
# setup.bat 이 이 파일을 .env 로 복사합니다. 복사된 .env 에 실제 키를 넣으세요.
# .env 는 .gitignore 에 걸려 커밋되지 않습니다.
#
# ⚠️ 이 파일(.env.example)에는 절대 실제 키를 넣지 마세요.
#    저장소에 커밋되는 파일이며, CI의 secret-guard 잡이 검사합니다.

# 사용할 LLM provider: gemini | claude | openai
LLM_PROVIDER=gemini

# Gemini API Key — https://aistudio.google.com/apikey  (따옴표 없이 값만)
GEMINI_API_KEY=

# Claude API Key — https://console.anthropic.com/
CLAUDE_API_KEY=

# OpenAI API Key — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# YouTube Data API v3 (선택) — youtube_search 정확도 향상용
YOUTUBE_API_KEY=

# 모델 오버라이드 (비워두면 provider별 기본값 사용)
# GEMINI_MODEL=gemini-2.5-flash
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# OPENAI_MODEL=gpt-4o-mini

# FastAPI 서버
SERVER_PORT=8765
SERVER_HOST=127.0.0.1

# 에이전트
AGENT_TIMEOUT=30

# 커맨드 캐시 (오프라인 실행 + 동적 학습)
CACHE_LEARNING=true
CACHE_MAX_DYNAMIC=200

# STT / TTS
WHISPER_MODEL=base
TTS_VOICE=ko-KR-SunHiNeural

# ※ USE_GRAPH 플래그는 M1-P5(엔진 단일화)에서 제거됐습니다.
#   PluizGraphAgent(그래프 + HITL 승인)가 유일한 엔진입니다.
#   설정해도 무시됩니다. → docs/design/M1_P5_엔진단일화.md
