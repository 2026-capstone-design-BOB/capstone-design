# Pluiz 환경변수 템플릿
# ─────────────────────────────────────────────────────────────
# setup.bat 이 이 파일을 .env 로 복사합니다. 복사된 .env 에 실제 키를 넣으세요.
# .env 는 .gitignore 에 걸려 커밋되지 않습니다.
#
# ⚠️ 이 파일(.env.example)에는 절대 실제 키를 넣지 마세요.
#    저장소에 커밋되는 파일이며, CI의 secret-guard 잡이 검사합니다.

# 사용할 LLM provider: gemini | claude | openai
LLM_PROVIDER=gemini

# Gemini API Key — https://aistudio.google.com/apikey  (따옴표 없이 값만)
GEMINI_API_KEY=

# Claude API Key — https://console.anthropic.com/
CLAUDE_API_KEY=

# OpenAI API Key — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# YouTube Data API v3 (선택) — youtube_search 정확도 향상용
YOUTUBE_API_KEY=

# 모델 오버라이드 (비워두면 provider별 기본값 사용)
# GEMINI_MODEL=gemini-2.5-flash
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# OPENAI_MODEL=gpt-4o-mini

# FastAPI 서버
SERVER_PORT=8765
SERVER_HOST=127.0.0.1

# 로컬 API 접근 제어 (BL-14) — 기본 켜짐. 그대로 두세요.
# 이 서버는 PC를 조작합니다. 끄면 사용자가 열어 둔 **아무 웹페이지**가 fetch 한 줄로
# 명령을 넣을 수 있습니다. 서버가 기동할 때마다 토큰을 발급해 cache/.auth_token 에
# 적고, Electron UI와 라이브 테스트가 그 파일을 읽습니다(웹페이지는 못 읽습니다).
# AUTH_ENABLED=false   # 디버깅용 탈출구. 평소엔 절대 켜지 마세요

# 에이전트
# 45인 이유: 화면 검증이 켜져 있으면 한 턴에 Vision 1회(약 8초)가 더해집니다.
AGENT_TIMEOUT=45

# 실행 결과 시각적 검증 (Phase 2) — 기본 켜짐.
# 도구를 실행한 뒤 화면을 실제로 보고 "진짜 됐나?"를 확인합니다.
# type_text·open_app처럼 **거짓으로 성공을 보고한 적이 있는 도구**에만 붙습니다.
# ⚠️ 켜져 있으면 그 도구를 쓸 때마다 **화면을 물어보지 않아도** 스크린샷이 외부 LLM으로
#    나갑니다. 화면에 비밀번호·계좌번호가 떠 있으면 그것도 함께 나갑니다(OWASP LLM02).
#    응답도 그 도구를 쓴 턴에서 약 8초 느려집니다.
# VISION_VERIFY_ENABLED=false   # 끄면 예전과 동일하게 동작합니다

# 화면 변화 모니터링 (Phase 2) — "오류 뜨면 알려줘"
# 화면을 지켜보다가 무언가 나타나면 Pluiz가 **먼저 말을 겁니다.**
# ⚠️ 지금까지 중 화면 전송량이 가장 큰 기능입니다(OWASP LLM02). 방어는 두 겹입니다.
#    ① 캡처 자체는 전부 로컬입니다 — 픽셀을 비교해 **변화가 있을 때만** 화면을 보냅니다.
#    ② SCREEN_WATCH_MAX_VISION_CALLS 가 곧 **밖으로 나가는 화면 장수의 상한**입니다.
#    시간·횟수 중 먼저 닿는 쪽에서 감시가 자동으로 멈추고, 멈춘 이유를 알려줍니다.
SCREEN_WATCH_ENABLED=true
SCREEN_WATCH_INTERVAL=5           # 초 — 화면을 들여다보는 주기(로컬 비교)
SCREEN_WATCH_MAX_MINUTES=10
SCREEN_WATCH_MAX_VISION_CALLS=20  # ← 외부로 나가는 화면 장수의 상한

# 커맨드 캐시 (오프라인 실행 + 동적 학습)
CACHE_LEARNING=true
CACHE_MAX_DYNAMIC=200

# STT / TTS
WHISPER_MODEL=base
TTS_VOICE=ko-KR-SunHiNeural

# 웨이크워드 — 마이크로 Pluiz를 부르는 말. 직접 바꿀 수 있습니다.
# 쉼표로 여러 개. 비워두면 기본값 "플루이즈"를 씁니다.
# "헤이 플루이즈"처럼 앞에 말을 붙여 불러도 인식합니다(부분매칭).
# 오인식 변형(플루이스·블루이즈 등)은 자동 생성되므로 적지 않아도 됩니다.
WAKE_WORDS=
WAKE_WORD_ENABLED=true

# 인식 튜닝 (환경마다 다릅니다)
# WAKEWORD_MODEL=base      # tiny / base. base가 오히려 5배 빠릅니다(tiny는 환각이 심함)
# WAKEWORD_ENERGY=0.008    # 무음 스킵 임계. 마이크가 작으면 낮추세요
# WAKEWORD_HOTWORDS=false  # 고유명사 편향. 켜면 환각이 늘어 기본은 꺼둡니다

# ⚠️ 웨이크워드는 sounddevice·faster-whisper가 설치된 python이 필요합니다.
#    Electron이 자동으로 찾지만, 못 찾으면 PLUIZ_PYTHON 환경변수로 지정하세요.
#    예: PLUIZ_PYTHON=C:\Users\이름\anaconda3\envs\pluiz\python.exe

# ※ USE_GRAPH 플래그는 M1-P5(엔진 단일화)에서 제거됐습니다.
#   PluizGraphAgent(그래프 + HITL 승인)가 유일한 엔진입니다.
#   설정해도 무시됩니다. → docs/design/M1_P5_엔진단일화.md
